# K.I.N.G.S. Author's Forge local runtime configuration
# Copy this file to .env and fill only the providers you actually use.
# .env is git-ignored. Never commit real API keys.

# Optional provider preference. Capability, health, quota and spend guards still win.
AI_PROVIDER_ORDER=omniroute,9router,openai,groq,mistral,gemini,anthropic,openrouter,ollama

# OmniRoute (OpenAI-compatible gateway)
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODELS=

# 9Router (OpenAI-compatible gateway)
ROUTER9_BASE_URL=
ROUTER9_API_KEY=
ROUTER9_MODELS=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODELS=

# Groq
GROQ_API_KEY=
GROQ_MODELS=

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODELS=

# Gemini
GEMINI_API_KEY=
GEMINI_MODELS=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

# Optional local Ollama fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELS=

# Optional K.I.N.G.S. Responses-compatible model endpoint.
# The normal K.I.N.G.S. owner/coding-machine URL is NOT a text-generation endpoint.
KINGS_AI_RESPONSES_URL=
KINGS_AI_API_KEY=
KINGS_AI_MODELS=

# Spend safety defaults to no-paid-tokens unless you deliberately change it in
# Forge AI controls. Do not put AI_LIVE_SMOKE=1 here unless you intentionally
# want live-certification commands to be armed whenever they are invoked.
